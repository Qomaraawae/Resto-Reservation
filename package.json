    "json-server": "^1.0.0-beta.15",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.51.0",
    "postcss": "^8.4.47",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
